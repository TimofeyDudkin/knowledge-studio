{
  "name": "knowledge-studio",
  "version": "0.1.0",
  "description": "Инструмент для глубокого изучения любой темы через дерево вопросов",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "mammoth": "^1.12.0",
    "electron-updater": "^6.3.4"
  },
  "build": {
    "appId": "com.knowledgestudio.app",
    "productName": "Knowledge Studio",
    "files": [
      "src/**/*",
      "!src/**/*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TimofeyDudkin",
        "repo": "knowledge-studio"
      }
    ]
  }
}
